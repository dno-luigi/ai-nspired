// src/llm-editor.mjs
var CF_MODEL = "@cf/meta/llama-3.1-8b-instruct-fast";
var OR_MODEL = "meta-llama/llama-3.3-70b-instruct";
var LLMEditor = class {
  constructor(env) {
    this.env = env;
  }
  async callCf(messages, maxTokens = 2048) {
    const res = await this.env.AI.run(CF_MODEL, { messages, max_tokens: maxTokens });
    return (res.response ?? "").trim();
  }
  async callOpenRouter(messages, maxTokens = 4096) {
    const key = this.env.OPENROUTER_API_KEY || this.env.CF_API_TOKEN || "";
    const base = this.env.OPENROUTER_BASE_URL || "https://openrouter.ai/api/v1";
    const res = await fetch(`${base}/chat/completions`, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "Authorization": `Bearer ${key}`,
        ...this.env.OPENROUTER_REF ? { "HTTP-Referer": this.env.OPENROUTER_REF } : {}
      },
      body: JSON.stringify({
        model: OR_MODEL,
        messages,
        max_tokens: maxTokens
      })
    });
    if (!res.ok) throw new Error(`OpenRouter ${res.status}`);
    const data = await res.json();
    return (data.choices?.[0]?.message?.content ?? "").trim();
  }
  async planContent(state, instruction, backend) {
    const system = `You are a code planner in a neuro-symbolic editing system. Given the current content and a natural language instruction, return a structured plan of the changes you WILL make. Be specific and concrete. Format as a numbered list. Do NOT apply any changes yet. Return only the plan, no preamble.`;
    const user = `CURRENT CONTENT:

${state.slice(0, 3e3)}

INSTRUCTION: ${instruction}`;
    const messages = [
      { role: "system", content: system },
      { role: "user", content: user }
    ];
    if (backend === "openrouter") return this.callOpenRouter(messages, 1024);
    try {
      return await this.callCf(messages, 1024);
    } catch (e) {
      if (backend === "cf") {
        try {
          return await this.callOpenRouter(messages, 1024);
        } catch (e2) {
          throw new Error(`CF and OpenRouter failed: ${e2.message}`);
        }
      }
      throw e;
    }
  }
  async buildContent(state, instruction, backend) {
    const system = `You are a code editor in a neuro-symbolic editing system. Given the current content and a natural language instruction, return the COMPLETE UPDATED content. Preserve all structure you do not need to change. Only modify what the instruction requests (or what is strictly necessary to satisfy it). Do not add commentary, do not wrap in code fences, do not explain. Return ONLY the updated content.`;
    const user = `CURRENT CONTENT:

${state.slice(0, 3e3)}

INSTRUCTION: ${instruction}`;
    const messages = [
      { role: "system", content: system },
      { role: "user", content: user }
    ];
    if (backend === "openrouter") return this.callOpenRouter(messages, 4096);
    try {
      return await this.callCf(messages, 2048);
    } catch (e) {
      if (backend === "cf") {
        try {
          return await this.callOpenRouter(messages, 4096);
        } catch (e2) {
          throw new Error(`CF and OpenRouter failed: ${e2.message}`);
        }
      }
      throw e;
    }
  }
};

// src/diff-engine.mjs
var MAX_HISTORY = 50;
var PREFIX = "diff:";
var META_KEY = "sandbox:meta";
var DiffEngine = class {
  constructor(env) {
    this.env = env;
    this.kv = env.EDITOR_KV;
  }
  async getHistory(cardId) {
    if (!this.kv) return [];
    const raw = await this.kv.get(PREFIX + cardId);
    return raw ? JSON.parse(raw) : [];
  }
  async recordDiff(cardId, instruction, previousState, newState) {
    if (!this.kv) return null;
    const history = await this.getHistory(cardId);
    history.push({
      timestamp: (/* @__PURE__ */ new Date()).toISOString(),
      instruction,
      previousState,
      newState
    });
    while (history.length > MAX_HISTORY) history.shift();
    await this.kv.put(PREFIX + cardId, JSON.stringify(history));
    await this.setMeta(cardId, { lastInstruction: instruction, lastAppliedAt: (/* @__PURE__ */ new Date()).toISOString() });
    return history;
  }
  async rollback(cardId) {
    if (!this.kv) return null;
    const history = await this.getHistory(cardId);
    if (history.length === 0) return null;
    const last = history.pop();
    await this.kv.put(PREFIX + cardId, JSON.stringify(history));
    return last.previousState;
  }
  async setMeta(cardId, extra = {}) {
    if (!this.kv) return;
    const key = META_KEY;
    const raw = await this.kv.get(key);
    const all = raw ? JSON.parse(raw) : {};
    all[cardId] = { ...all[cardId] || {}, ...extra };
    await this.kv.put(key, JSON.stringify(all));
  }
  async getMeta(cardId) {
    if (!this.kv) return {};
    const raw = await this.kv.get(META_KEY);
    if (!raw) return {};
    const all = JSON.parse(raw);
    return all[cardId] || {};
  }
  async clear(cardId) {
    if (!this.kv) return;
    await this.kv.delete(PREFIX + cardId);
  }
};

// src/worker.mjs
var INDEX_HTML = `<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>PLAYGROUND \xB7 NSM</title>
<style>
  :root {
    --bg: #0b0b16; --panel: #12122a; --panel2: #171736; --border: #2a2a4a;
    --text: #e0e0f0; --muted: #8888aa; --accent: #ff6b1a; --accent2: #4ab8ff;
    --ok: #4aff8a; --err: #ff4a6a; --added: #163a26; --removed: #3a1620;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text); font-family: 'Inter', system-ui, sans-serif; height: 100vh; overflow: hidden; }
  .root { display: flex; flex-direction: column; height: 100vh; }
  .topbar { height: 52px; display: flex; align-items: center; gap: 10px; padding: 0 16px; background: var(--panel); border-bottom: 1px solid var(--border); flex-shrink: 0; }
  .logo { font-size: 15px; font-weight: 800; letter-spacing: 1px; color: var(--accent); margin-right: 8px; white-space: nowrap; }
  .logo span { color: var(--text); }
  .btn { padding: 6px 12px; border: 1px solid var(--border); border-radius: 6px; background: var(--panel2); color: var(--text); font-size: 12px; font-weight: 600; cursor: pointer; transition: all .15s; white-space: nowrap; }
  .btn:hover { border-color: var(--accent); color: var(--accent); }
  .btn.primary { background: var(--accent); color: #0d0d16; border-color: var(--accent); }
  .btn.primary:hover { background: #ff8533; }
  .btn.ok { background: #0f2a1a; color: var(--ok); border-color: #2a6a3a; }
  .btn.ok:hover { border-color: var(--ok); }
  .btn.danger { border-color: #4a2a2a; color: var(--err); }
  .btn.danger:hover { background: #2a0f1a; border-color: var(--err); }
  .btn:disabled { opacity: .4; cursor: not-allowed; }
  .btn .em { margin-right: 5px; }
  .sep { width: 1px; height: 22px; background: var(--border); margin: 0 4px; }
  .spacer { flex: 1; }
  .main { display: flex; flex: 1; min-height: 0; }
  .sidebar { width: 240px; border-right: 1px solid var(--border); display: flex; flex-direction: column; background: var(--panel); flex-shrink: 0; }
  .sidebar .head { padding: 10px 14px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: var(--muted); border-bottom: 1px solid var(--border); }
  .staged-list { flex: 1; overflow-y: auto; }
  .staged-item { padding: 9px 14px; cursor: pointer; border-bottom: 1px solid #1c1c36; display: flex; align-items: center; gap: 8px; font-size: 12px; }
  .staged-item:hover { background: var(--panel2); }
  .staged-item.active { background: #1f1f42; border-left: 3px solid var(--accent); }
  .staged-item .dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
  .dot.new { background: var(--ok); }
  .dot.pushed { background: var(--accent2); }
  .staged-item .label { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text); }
  .staged-item .type { font-size: 9px; text-transform: uppercase; color: var(--muted); }
  .work { flex: 1; display: flex; flex-direction: column; min-width: 0; }
  .pane-row { display: flex; flex: 1; min-height: 0; }
  .left { flex: 1; display: flex; flex-direction: column; min-width: 0; border-right: 1px solid var(--border); }
  .right { flex: 1; display: flex; flex-direction: column; min-width: 0; }
  .section-label { padding: 8px 14px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: var(--muted); border-bottom: 1px solid var(--border); flex-shrink: 0; }
  .stage { flex: 1; min-height: 0; overflow: auto; padding: 10px; }
  .stage iframe { width: 100%; height: 100%; border: none; background: #fff; border-radius: 8px; }
  .preview { width: 100%; min-height: 100%; background: var(--panel); border: 1px solid var(--border); border-radius: 8px; padding: 14px 18px; font-size: 13px; line-height: 1.6; white-space: pre-wrap; word-wrap: break-word; }
  .preview h1{font-size:20px;font-weight:700;margin:8px 0 4px;} .preview h2{font-size:17px;font-weight:600;margin:8px 0 4px;}
  .preview h3{font-size:15px;font-weight:600;margin:6px 0 3px;} .preview a{color:var(--accent2);}
  .preview pre{background:#0d0d1a;border:1px solid var(--border);border-radius:6px;padding:10px;overflow:auto;}
  .preview code{background:#0d0d1a;padding:1px 4px;border-radius:3px;}
  .preview blockquote{border-left:3px solid var(--border);padding-left:12px;color:var(--muted);margin:8px 0;}
  .preview ul,.preview ol{padding-left:20px;}
  .empty { display: flex; align-items: center; justify-content: center; height: 100%; color: var(--muted); font-size: 13px; text-align: center; padding: 20px; }
  .input-panel { padding: 10px 14px; border-top: 1px solid var(--border); background: var(--panel); flex-shrink: 0; }
  .input-panel textarea { width: 100%; background: var(--bg); color: var(--text); border: 1px solid var(--border); border-radius: 8px; padding: 9px 12px; font-family: monospace; font-size: 13px; resize: none; min-height: 52px; line-height: 1.5; }
  .input-panel textarea:focus { outline: none; border-color: var(--accent); }
  .controls { display: flex; gap: 8px; align-items: center; margin-top: 8px; flex-wrap: wrap; }
  .backend-toggle { display: flex; gap: 2px; }
  .backend-toggle button { padding: 5px 12px; font-size: 11px; font-weight: 700; border: 1px solid var(--border); background: var(--panel2); color: var(--muted); cursor: pointer; border-radius: 4px; }
  .backend-toggle button.active { background: var(--accent); color: #0d0d16; border-color: var(--accent); }
  .diff-panes { display: flex; gap: 8px; flex: 1; min-height: 0; padding: 0 14px; }
  .diff-pane { flex: 1; min-width: 0; display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: 8px; overflow: hidden; background: var(--panel); }
  .diff-pane .pane-head { padding: 6px 10px; font-size: 11px; font-weight: 700; color: var(--muted); border-bottom: 1px solid var(--border); background: var(--panel2); }
  .diff-pane .pane-body { flex: 1; overflow: auto; font-family: monospace; font-size: 12px; line-height: 1.5; padding: 8px 10px; white-space: pre-wrap; word-wrap: break-word; }
  .diff-line-add { background: var(--added); color: #b8ffc8; }
  .actions { display: flex; gap: 8px; padding: 10px 14px; border-top: 1px solid var(--border); flex-shrink: 0; background: var(--panel); align-items: center; flex-wrap: wrap; }
  .flash { padding: 4px 12px; border-radius: 6px; font-size: 12px; font-weight: 600; border: 1px solid var(--border); }
  .flash.ok { background: #0f2a1a; color: var(--ok); border-color: #2a6a3a; }
  .flash.err { background: #2a0f1a; color: var(--err); border-color: #6a2a3a; }
  .plan { padding: 10px 14px; font-size: 13px; line-height: 1.6; white-space: pre-wrap; color: var(--accent2); }
  .spinner { display: inline-block; width: 13px; height: 13px; border: 2px solid var(--border); border-top-color: var(--accent); border-radius: 50%; animation: spin .8s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .badge { padding: 2px 8px; border-radius: 4px; font-size: 9px; font-weight: 700; text-transform: uppercase; }
  .badge.browser{background:#1a4a6a;color:#4ab8ff;} .badge.document{background:#2a3a1a;color:#8aff4a;}
  .badge.instruct{background:#4a2a1a;color:#ff8a4a;} .badge.import{background:#3a1a4a;color:#c14aff;}
  .badge.search{background:#1a3a3a;color:#4affc8;} .badge.other{background:#2a2a4a;color:var(--text);}
  .prompt-modal { position: fixed; inset: 0; background: rgba(0,0,0,.6); display: none; align-items: center; justify-content: center; z-index: 100; }
  .prompt-modal.show { display: flex; }
  .prompt-box { background: var(--panel); border: 1px solid var(--border); border-radius: 12px; padding: 22px; width: 520px; max-width: 90vw; }
  .prompt-box h3 { margin: 0 0 12px; font-size: 15px; }
  .prompt-box input, .prompt-box textarea { width: 100%; background: var(--bg); color: var(--text); border: 1px solid var(--border); border-radius: 8px; padding: 10px 12px; font-size: 13px; margin-bottom: 12px; }
  .prompt-box textarea { min-height: 80px; font-family: monospace; resize: vertical; }
  .prompt-box .row { display: flex; gap: 8px; justify-content: flex-end; }
</style>
</head>
<body>
<div class="root">
  <div class="topbar">
    <div class="logo">NSM<span> \xB7 PLAYGROUND</span></div>
    <button class="btn" onclick="stageCard('Browser')"><span class="em">\u{1F310}</span>Browser</button>
    <button class="btn" onclick="stageCard('Document')"><span class="em">\u{1F4C4}</span>Document</button>
    <button class="btn" onclick="stageCard('Instruct')"><span class="em">\u26A1</span>Instruct</button>
    <button class="btn" onclick="stageCard('Import')"><span class="em">\u{1F4CC}</span>Import</button>
    <button class="btn" onclick="stageCard('Search')"><span class="em">\u{1F50D}</span>Search</button>
    <span class="sep"></span>
    <button class="btn" onclick="stageCard('Query')" style="color:#4a9fff;">\u{1F50E} Query</button>
    <button class="btn" onclick="stageCard('Audit')" style="color:#ff4a6a;">\u{1F50D} Audit</button>
    <button class="btn" onclick="stageCard('Domain')" style="color:#c8c84a;">\u{1F30D} Domain</button>
    <div class="spacer"></div>
    <button class="btn primary" onclick="pushCurrent()">Push to Workspace \u25B8</button>
    <button class="btn danger" onclick="discardCurrent()">Discard</button>
  </div>
  <div class="main">
    <div class="sidebar">
      <div class="head">Playground Cards</div>
      <div class="staged-list" id="stagedList"><div class="empty">Click a type button above to stage a card</div></div>
    </div>
    <div class="work">
      <div class="pane-row">
        <div class="left">
          <div class="section-label"><span id="curMeta"></span></div>
          <div class="stage" id="currentStage"><div class="empty">Stage a card to begin \xB7 this is just the playground \u2014 push to commit to the workspace</div></div>
        </div>
        <div class="right">
          <div class="section-label">Sandbox Preview</div>
          <div class="stage" id="sandboxStage"><div class="empty">Build or Generate to preview changes here</div></div>
        </div>
      </div>
      <div class="diff-panes" id="diffPanes" style="display:none;">
        <div class="diff-pane"><div class="pane-head">Original</div><div class="pane-body" id="diffOriginal"></div></div>
        <div class="diff-pane"><div class="pane-head">Proposed</div><div class="pane-body" id="diffProposed"></div></div>
      </div>
      <div id="planOutput" class="plan" style="display:none;"></div>
      <div class="actions" id="actionsBar">
        <button class="btn" onclick="planEdit()">Plan</button>
        <button class="btn primary" onclick="buildEdit()">Build</button>
        <button class="btn ok" onclick="applySandbox()">Apply</button>
        <button class="btn danger" onclick="revertCurrent()">Revert Last</button>
        <div class="backend-toggle" id="backendToggle">
          <button data-backend="cf" class="active" onclick="setBackend('cf')">CF</button>
          <button data-backend="openrouter" onclick="setBackend('openrouter')">OR</button>
        </div>
        <span id="flashMsg" class="flash"></span>
      </div>
      <div class="input-panel">
        <textarea id="instruction" placeholder="Describe edits in natural language\u2026 (or generator prompt)"></textarea>
        <div class="controls">
          <button class="btn" onclick="genFromPrompt()">Generate from Prompt</button>
          <div class="backend-toggle" id="genBackend">
            <button data-backend="cf" class="active" onclick="setGenBackend('cf')">CF</button>
            <button data-backend="openrouter" onclick="setGenBackend('openrouter')">OR</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="prompt-modal" id="promptModal">
  <div class="prompt-box">
    <h3 id="promptTitle">New</h3>
    <input id="promptUrl" placeholder="Enter URL\u2026" style="display:none;">
    <textarea id="promptText" placeholder="Describe what you want\u2026"></textarea>
    <div class="row">
      <button class="btn" onclick="closePrompt()">Cancel</button>
      <button class="btn primary" id="promptGo" onclick="confirmPrompt()">Create</button>
    </div>
  </div>
</div>
<script>
(function(){
  let staged = [];
  let current = null;
  let active = null;
  let backend = 'cf';
  let genBackend = 'cf';
  let pendingType = null;
  let sandbox = { original: null, proposed: null, instruction: null, fetched: false };

  const $ = id => document.getElementById(id);

  function stageCard(type) {
    pendingType = type;
    $('promptTitle').textContent = 'New ' + type + ' Card';
    $('promptUrl').style.display = type === 'Browser' ? 'block' : 'none';
    $('promptText').placeholder = type === 'Instruct' ? 'Describe what you want generated through the principle stack\u2026'
      : type === 'Document' ? 'Describe the document you want (or leave blank for blank), or paste existing content\u2026'
      : type === 'Search' ? 'Enter your search query\u2026'
      : type === 'Query' ? 'Enter your query\u2026'
      : type === 'Audit' ? 'Enter what you want audited\u2026'
      : type === 'Domain' ? 'Which domain?'
      : type === 'Import' ? 'Describe or paste the content to import\u2026'
      : 'Describe what you want\u2026';
    $('promptText').value = '';
    $('promptUrl').value = '';
    $('promptModal').classList.add('show');
    setTimeout(()=>$('promptText').focus(), 50);
  }
  window.stageCard = stageCard;

  function closePrompt(){ $('promptModal').classList.remove('show'); pendingType=null; }
  window.closePrompt = closePrompt;

  window.confirmPrompt = async function() {
    const type = pendingType;
    const text = $('promptText').value.trim();
    const url = $('promptUrl').value.trim();
    closePrompt();
    let card = { id: 'stg_' + (staged.length + 1) + '_' + Date.now(), type, title: capitalize(type), content: '', rawHtml: '', url: '', status: 'new' };
    if (type === 'Browser') {
      card.url = url || text;
      card.title = card.url || 'Browser';
      try {
        const res = await fetch('/api/fetch?url=' + encodeURIComponent(card.url));
        const data = await res.json();
        if (data.error) { flash(data.error, 'err'); return; }
        card.rawHtml = data.rawHtml; card.content = data.content; card.title = data.title || card.title;
      } catch (e) { flash('Fetch failed: ' + e.message, 'err'); return; }
    } else {
      card.url = '';
      if (text && type !== 'Search' && type !== 'Query' && type !== 'Audit' && type !== 'Domain') {
        card.content = text; // seed; generator can refine
      }
    }
    staged.push(card);
    current = card; active = card.id;
    renderSidebar(); renderCard(); resetSandbox();
  };

  function capitalize(s){ return s.charAt(0).toUpperCase() + s.slice(1); }

  function renderSidebar() {
    const list = $('stagedList');
    if (!staged.length) { list.innerHTML = '<div class="empty">Click a type button above to stage a card</div>'; return; }
    list.innerHTML = '';
    staged.forEach(c => {
      const el = document.createElement('div');
      el.className = 'staged-item' + (c.id === active ? ' active' : '');
      el.title = c.title;
      el.innerHTML = '<span class="dot ' + c.status + '"></span><span class="label">' + esc(c.title) + '</span><span class="type">' + esc(c.type) + '</span>';
      el.onclick = () => { current = c; active = c.id; renderSidebar(); renderCard(); resetSandbox(); };
      list.appendChild(el);
    });
  }

  function editable(c){ return c.type === 'Browser' ? (c.rawHtml || c.content || '') : (c.content || ''); }

  function renderCard() {
    if (!current) return;
    const stage = $('currentStage');
    const meta = $('curMeta');
    const type = current.type;
    meta.innerHTML = '<span class="badge ' + (type==='Browser'?'browser':type==='Document'?'document':type==='Instruct'?'instruct':type==='Import'?'import':type==='Search'?'search':'other') + '">' + type + '</span> ' + esc(current.title||'');
    if (type === 'Browser' && current.url) {
      stage.innerHTML = '<iframe src="/api/proxy?url=' + encodeURIComponent(current.url) + '" sandbox="allow-scripts allow-forms allow-popups allow-same-origin"></iframe>';
    } else {
      stage.innerHTML = '<div class="preview" id="curPreview">' + renderMd(editable(current)) + '</div>';
    }
  }

  function renderSandbox(content) {
    const stage = $('sandboxStage');
    if (!content) { stage.innerHTML = '<div class="empty">Build or Generate to preview</div>'; return; }
    if (current && current.type === 'Browser') {
      stage.innerHTML = '<iframe id="sbIframe" sandbox="allow-scripts allow-forms allow-popups allow-same-origin"></iframe>';
      const doc = $('sbIframe').contentDocument;
      if (doc) { doc.open(); doc.write(content); doc.close(); }
    } else {
      stage.innerHTML = '<div class="preview">' + renderMd(content) + '</div>';
    }
  }

  function renderMd(md) {
    let h = esc(md);
    h = h.replace(/\`\`\`(w*)
([sS]*?)\`\`\`/g,'<pre><code>$2</code></pre>');
    h = h.replace(/\`([^\`]+)\`/g,'<code>$1</code>');
    h = h.replace(/^###### (.+)$/gm,'<h6>$1</h6>').replace(/^##### (.+)$/gm,'<h5>$1</h5>').replace(/^#### (.+)$/gm,'<h4>$1</h4>').replace(/^### (.+)$/gm,'<h3>$1</h3>').replace(/^## (.+)$/gm,'<h2>$1</h2>').replace(/^# (.+)$/gm,'<h1>$1</h1>');
    h = h.replace(/***(.+?)***/g,'<strong><em>$1</em></strong>').replace(/**(.+?)**/g,'<strong>$1</strong>').replace(/*(.+?)*/g,'<em>$1</em>');
    h = h.replace(/![([^]]*)](([^)]+))/g,'<img src="$2" alt="$1" style="max-width:100%">');
    h = h.replace(/[([^]]+)](([^)]+))/g,'<a href="$2" target="_blank">$1</a>');
    h = h.replace(/^- (.+)$/gm,'<li>$1</li>').replace(/^s*- (.+)$/gm,'<li>$1</li>');
    h = h.replace(/^d+. (.+)$/gm,'<li>$1</li>');
    h = h.replace(/

/g,'<br>');
    return '<div>'+h+'</div>';
  }

  function resetSandbox() {
    sandbox = { original: null, proposed: null, instruction: null, fetched: false };
    $('diffPanes').style.display = 'none';
    $('planOutput').style.display = 'none';
    $('sandboxStage').innerHTML = '<div class="empty">Build or Generate to preview</div>';
    $('flashMsg').className = 'flash'; $('flashMsg').textContent = '';
  }
  window.resetSandbox = resetSandbox;

  function setBackend(b){ backend = b; document.querySelectorAll('#backendToggle button').forEach(x=>x.classList.toggle('active', x.dataset.backend===b)); }
  window.setBackend = setBackend;
  function setGenBackend(b){ genBackend = b; document.querySelectorAll('#genBackend button').forEach(x=>x.classList.toggle('active', x.dataset.backend===b)); }
  window.setGenBackend = setGenBackend;

  window.genFromPrompt = async function() {
    if (!current) { flash('Stage a card first', 'err'); return; }
    const prompt = $('instruction').value.trim();
    if (!prompt) { flash('Enter a prompt', 'err'); return; }
    disabled(true);
    try {
      const res = await fetch('/api/generate', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ type: current.type, prompt, backend: genBackend, current: editable(current) }) });
      const data = await res.json();
      if (data.error) { flash(data.error, 'err'); return; }
      if (current.type === 'Browser') current.rawHtml = data.result;
      else current.content = data.result;
      if (data.title && data.title !== 'Untitled') current.title = data.title;
      renderCard(); renderSidebar(); resetSandbox();
      flash('Generated \u2713 review then push', 'ok');
    } catch(e){ flash('Generate failed: '+e.message,'err'); }
    finally { disabled(false); }
  };

  window.planEdit = async function() {
    if (!current) { flash('Stage a card first','err'); return; }
    const instruction = $('instruction').value.trim();
    if (!instruction) { flash('Describe edits first','err'); return; }
    disabled(true);
    try {
      const res = await fetch('/api/plan', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ instruction, backend, content: editable(current) }) });
      const data = await res.json();
      if (data.error) { flash(data.error,'err'); return; }
      $('planOutput').style.display = 'block';
      $('planOutput').textContent = data.plan || '(no plan)';
    } catch(e){ flash('Plan failed: '+e.message,'err'); }
    finally { disabled(false); }
  };

  window.buildEdit = async function() {
    if (!current) { flash('Stage a card first','err'); return; }
    const instruction = $('instruction').value.trim();
    if (!instruction) { flash('Describe edits first','err'); return; }
    disabled(true);
    try {
      const original = editable(current);
      const res = await fetch('/api/build', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ instruction, backend, content: original }) });
      const data = await res.json();
      if (data.error) { flash(data.error,'err'); return; }
      sandbox = { original, proposed: data.proposed, instruction, fetched: true };
      $('planOutput').style.display = 'none';
      $('diffPanes').style.display = '';
      renderDiff(original, data.proposed);
      renderSandbox(data.proposed);
      flash('Built preview \xB7 review then Apply or Push','ok');
    } catch(e){ flash('Build failed: '+e.message,'err'); }
    finally { disabled(false); }
  };

  function renderDiff(orig, prop) {
    $('diffPanes').style.display = '';
    $('diffOriginal').innerHTML = (orig||'').split('\\n').map(l=>'<div>'+esc(l)+'&nbsp;</div>').join('');
    const a = orig.split('\\n'); const b = prop.split('\\n');
    let html=''; b.forEach(l=>{ const same = a.indexOf(l)!==-1; html+='<div class="'+(same?'':'diff-line-add')+'">'+esc(l)+'&nbsp;</div>'; });
    $('diffProposed').innerHTML = html;
  }

  window.applySandbox = async function() {
    if (!sandbox.fetched || !current) { flash('Build changes first','err'); return; }
    if (current.type === 'Browser') current.rawHtml = sandbox.proposed;
    else current.content = sandbox.proposed;
    sandbox.fetched = false; sandbox.proposed = null;
    renderCard(); resetSandbox();
    flash('Applied to playground \u2713 (push to commit to workspace)','ok');
  };

  window.pushCurrent = async function() {
    if (!current) { flash('Stage a card first','err'); return; }
    const c = current;
    const btn = event ? event.target : null;
    if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner"></span>'; }
    try {
      const payload = { type: c.type, title: c.title, content: c.content };
      if (c.type === 'Browser') { payload.url = c.url; payload.rawHtml = c.rawHtml; }
      const res = await fetch('/api/push', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
      const data = await res.json();
      if (data.error) { flash(data.error,'err'); return; }
      c.status = 'pushed';
      renderSidebar();
      flash('Pushed to workspace \u2713 '+data.url,'ok');
    } catch(e){ flash('Push failed: '+e.message,'err'); }
    finally { if (btn) { btn.disabled = false; btn.innerHTML = 'Push to Workspace \u25B8'; } }
  };

  window.discardCurrent = async function() {
    if (!current) return;
    staged = staged.filter(c => c.id !== current.id);
    current = staged[0] || null; active = current ? current.id : null;
    renderSidebar();
    if (current) renderCard(); else $('currentStage').innerHTML = '<div class="empty">Stage a card to begin</div>';
    resetSandbox();
  };

  window.revertCurrent = async function() {
    if (!current) { flash('No card','err'); return; }
    // only reverts sandbox (playground is source of truth); workspace revert handled server-side on pushed card
    if (sandbox.fetched) { resetSandbox(); flash('Sandbox reverted (set back to current)',''); }
    else flash('Nothing to revert in playground','');
  };

  function disabled(v){}

  function flash(msg, type){ const el=$('flashMsg'); el.className='flash '+(type||''); el.textContent=msg||''; }
  function esc(s){ return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
})();
<\/script>
</body>
</html>`;
function cors() {
  const h = new Headers();
  h.set("Access-Control-Allow-Origin", "*");
  h.set("Access-Control-Allow-Methods", "GET, POST, PATCH, DELETE, OPTIONS");
  h.set("Access-Control-Allow-Headers", "Content-Type");
  return h;
}
function json(data, status = 200) {
  return new Response(JSON.stringify(data), { status, headers: { "Content-Type": "application/json", ...cors() } });
}
var worker_default = {
  async fetch(request, env) {
    const url = new URL(request.url);
    const path = url.pathname;
    if (request.method === "OPTIONS") return new Response(null, { status: 204, headers: cors() });
    const llm = new LLMEditor(env);
    const diff = new DiffEngine(env);
    const teUrl = env.TRUTH_ENGINE_URL || "https://truth-engine-workspace.ai-n.workers.dev";
    async function callTE(tePath, init) {
      if (env.TRUTH_ENGINE) return env.TRUTH_ENGINE.fetch(`https://truth-engine.internal${tePath}`, init);
      return fetch(`${teUrl}${tePath}`, init);
    }
    if (path === "/" || path === "/editor") {
      return new Response(INDEX_HTML, { headers: { "Content-Type": "text/html; charset=utf-8", ...cors() } });
    }
    if (path === "/api/fetch" && request.method === "GET") {
      const target = url.searchParams.get("url");
      if (!target) return json({ error: "Missing url" }, 400);
      try {
        const res = await fetch(target, { headers: { "User-Agent": "Mozilla/5.0 (compatible; TruthEngineEditor/1.0)" } });
        const rawHtml = await res.text();
        const titleMatch = rawHtml.match(/<title[^>]*>([^<]*)<\/title>/i);
        const title = titleMatch ? titleMatch[1].trim() : target;
        const body = rawHtml.replace(/<script[\s\S]*?<\/script>/gi, "").replace(/<style[\s\S]*?<\/style>/gi, "").replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim().slice(0, 8e3);
        return json({ title, rawHtml, content: body });
      } catch (e) {
        return json({ error: "Fetch failed: " + e.message }, 502);
      }
    }
    if (path === "/api/proxy" && request.method === "GET") {
      const target = url.searchParams.get("url");
      if (!target) return json({ error: "Missing url" }, 400);
      try {
        const res = await fetch(target, { headers: { "User-Agent": "Mozilla/5.0 (compatible; TruthEngineEditor/1.0)" } });
        const ct = res.headers.get("content-type") || "text/html";
        let html = await res.text();
        const baseTag = `<base href="${target.replace(/\/[^/]*$/, "/")}">`;
        html = html.replace(/<head([^>]*)>/i, (m, attrs) => `<head${attrs}>${baseTag}`);
        return new Response(html, { headers: { "Content-Type": ct, "Content-Security-Policy": "", "X-Frame-Options": "", "Access-Control-Allow-Origin": "*" } });
      } catch (e) {
        return json({ error: "Proxy failed: " + e.message }, 502);
      }
    }
    if (path === "/api/generate" && request.method === "POST") {
      const body = await request.json();
      try {
        const genType = body.type || "Document";
        let instruction = body.prompt;
        const current = body.current || "";
        if (genType === "Browser") {
          instruction = (current ? `Existing HTML:
${current.slice(0, 1500)}

` : "") + "Generate a complete standalone HTML page. " + body.prompt;
        } else if (genType === "Instruct") {
          instruction = "Generate output through the active principle stack. " + body.prompt;
        }
        const raw = await llm.buildContent(body.current || "", instruction, body.backend || "cf");
        const proposed = stripFences(raw);
        const title = deriveTitle(proposed, genType, body.prompt);
        return json({ result: proposed, title });
      } catch (e) {
        return json({ error: "Generate failed: " + e.message }, 500);
      }
    }
    if (path === "/api/plan" && request.method === "POST") {
      const body = await request.json();
      try {
        const plan = await llm.planContent(body.content || "", body.instruction, body.backend || "cf");
        return json({ mode: "plan", plan });
      } catch (e) {
        return json({ error: "Plan failed: " + e.message }, 500);
      }
    }
    if (path === "/api/build" && request.method === "POST") {
      const body = await request.json();
      try {
        const raw = await llm.buildContent(body.content || "", body.instruction, body.backend || "cf");
        return json({ proposed: stripFences(raw), original: body.content || "" });
      } catch (e) {
        return json({ error: "Build failed: " + e.message }, 500);
      }
    }
    if (path === "/api/push" && request.method === "POST") {
      const body = await request.json();
      try {
        const res = await callTE("/api/cards", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
        if (!res.ok) return json({ error: "Push failed: " + res.status }, 502);
        const card = await res.json();
        return json({ ok: true, id: card.id });
      } catch (e) {
        return json({ error: "Push failed: " + e.message }, 500);
      }
    }
    if (path === "/api/meta" && request.method === "GET") {
      return json({ ok: true });
    }
    return json({ error: "Not found" }, 404);
  }
};
function stripFences(s) {
  if (!s) return "";
  return s.replace(/^```[a-zA-Z]*\s*[\r\n]+/g, "").replace(/[\r\n]+\s*```\s*$/g, "").replace(/\r?\n\s*```\s*$/g, "").trim();
}
function deriveTitle(content, type, prompt) {
  if (!content && !prompt) return "Untitled";
  if (type === "Browser") {
    const m = content && (content.match(/<title[^>]*>([^<]*)<\/title>/i) || content.match(/<h1[^>]*>([^<]*)<\/h1>/i));
    if (m && m[1] && m[1].trim()) return m[1].trim().slice(0, 60);
  }
  if (content) {
    const heading = content.match(/^#\s+(.+)$/m);
    if (heading && heading[1].trim()) return heading[1].trim().slice(0, 60);
  }
  if (prompt) {
    const clean = prompt.replace(/["']/g, "").trim().slice(0, 60);
    if (clean) return clean.replace(/\.$/, "");
  }
  const firstLine = content ? content.split("\n").map((l) => l.trim()).find((l) => l.length > 0) : "";
  if (firstLine) return firstLine.replace(/[#*\->]/g, "").trim().slice(0, 40);
  return "Untitled";
}
export {
  worker_default as default
};

